<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- USB 호스트(OTG) 필수 -->
    <uses-feature android:name="android.hardware.usb.host" android:required="true" />
    <!-- 폰 인터넷 표시 + 광고를 LTE/Wi-Fi 로만 내보내기 위한 네트워크 확인 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 기본 네트워크가 USB 이더넷일 때 셀룰러/Wi-Fi 를 요청한다. 설치 시 부여되는 일반 권한. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- 광고와 UMP 동의 전용. Modbus/USB 스택은 소켓을 쓰지 않는다. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <!-- 값은 res/values/ads.xml. 지금은 Google 테스트 앱 ID. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/admob_application_id" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 어댑터를 꽂으면 앱 실행 제안 + "항상 이 앱 사용" 선택 시 권한 팝업 생략 -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>
    </application>
</manifest>
